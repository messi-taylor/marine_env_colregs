Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/Global Options1, /OS GT1, /OS EKF1, /ts16a1, /ts16b1, /ts16c1, /ts16d1]
      Splitter Ratio: 0.5
    Tree Height: 450
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.12
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 80; 80; 80
      Enabled: true
      Line Style: {Line Width: 0.02, Value: Lines}
      Name: Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: map
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 220; 255
      Enabled: true
      Line Style: {Line Width: 0.08, Value: Lines}
      Name: OS GT
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /wamv/trajectory_gt}
      Value: true
    - Alpha: 0.7
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 80; 255; 100
      Enabled: true
      Line Style: {Line Width: 0.04, Value: Lines}
      Name: OS EKF
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /wamv/trajectory_ekf}
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 40; 40
      Enabled: true
      Line Style: {Line Width: 0.06, Value: Lines}
      Name: ts16a
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /ts16a/trajectory}
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 140; 0
      Enabled: true
      Line Style: {Line Width: 0.06, Value: Lines}
      Name: ts16b
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /ts16b/trajectory}
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 200; 60; 255
      Enabled: true
      Line Style: {Line Width: 0.06, Value: Lines}
      Name: ts16c
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /ts16c/trajectory}
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 200; 0
      Enabled: true
      Line Style: {Line Width: 0.06, Value: Lines}
      Name: ts16d
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /ts16d/trajectory}
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 22
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current: {Class: rviz_default_plugins/TF}
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point: {X: -3, Y: 0, Z: 0}
      Name: Current View
      Pitch: 1.2
      Target Frame: map
      Yaw: 3.0
    Saved: ~
Window Geometry:
  Displays: {collapsed: false}
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
